# Huntsville Massage Professionals — Apache config (DreamHost / Apache 2.4).
# NOTE: Apache-only. On nginx, translate these rules in your server block
# (deny /storage, /includes, config.php; protect /crm).

Options -Indexes
DirectoryIndex index.php index.html

# Never serve the database, PHP includes, or config over the web.
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db)$">
  Require all denied
</FilesMatch>

RedirectMatch 403 ^/storage/.*$
RedirectMatch 403 ^/includes/.*$
RedirectMatch 403 ^/config\.php$
